<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Land Management suite (portal/v2 listener) - all 7 live-verified land
     types (see future/Framework_Context.md section 10/10b). Redevelopment
     stays out: different flow + known site defect (LM_199). Keep the class
     list in sync with land.xml - these two are the ONLY land suite XMLs. -->
<suite name="Land Management Suite">
<listeners>
    <listener class-name="ReportManager.Master_extent_report_v2"/>
</listeners>

	<test name="land Management Tests" thread-count="1">

		<classes>

			<class name="testCases.LandModule.login" />

			<class name="testCases.LandModule.GovernmentLandCreation" />
			<class name="testCases.LandModule.DepositWorkLandCreation" />
			<class name="testCases.LandModule.HousingRedensificationLandCreation" />
			<class name="testCases.LandModule.LandAcquisitionActLandCreation" />
			<class name="testCases.LandModule.LandPullingLandCreation" />
			<class name="testCases.LandModule.PrivateLandLandCreation" />
			<class name="testCases.LandModule.RedensificationGovtLandCreation" />

		</classes>

	</test>

</suite>
