    <test name="Architect Empanelment Tests">
        <classes>
            <class name="testCases.ArchitectEmpanelment.TC_001_LaunchUrl"/>
            <class name="testCases.ArchitectEmpanelment.SignupNegativeTests"/>
            <class name="testCases.ArchitectEmpanelment.IndividualEmpanelmentFlow"/>
            <class name="testCases.ArchitectEmpanelment.ProprietorshipEmpanelmentFlow"/>
            <class name="testCases.ArchitectEmpanelment.PartnershipEmpanelmentFlow"/>
            <class name="testCases.ArchitectEmpanelment.PvtLtdEmpanelmentFlow"/>
            <class name="testCases.ArchitectEmpanelment.PublicLtdEmpanelmentFlow"/>
            <class name="testCases.ArchitectEmpanelment.LlpEmpanelmentFlow"/>
        </classes>
    </test>

</suite>
