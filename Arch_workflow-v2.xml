<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Architect workflow Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="ReportManager.Master_extent_report_v2"/>
    </listeners>

    <test name="Land Module Tests">
        <classes>
            <class name="testCases.LandModule.login"/>
            <class name="testCases.LandModule.GovernmentLandCreation"/>
